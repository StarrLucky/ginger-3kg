# === API Security ===
# Секретный ключ для доступа к API
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOOD_API_KEY=

# === Часовой пояс ===
# Определяет границы "дня" для подсчёта калорий (IANA-имя зоны).
# Сервер rpi живёт в +04 -> Etc/GMT-4 (знак в Etc/* инвертирован!)
USER_TIMEZONE=Etc/GMT-4

# === Распознавание (шаг 1) ===
# Провайдер или список через запятую — порядок задаёт фолбэк: anthropic,local
RECOGNIZE_PROVIDER=anthropic
# Модель Anthropic. По умолчанию claude-opus-5.
RECOGNIZE_MODEL=
ANTHROPIC_API_KEY=
# Gemini — бесплатный тариф, но Google учится на данных free tier.
GEMINI_API_KEY=
# Ollama на M4: полный URL эндпоинта, не базовый адрес.
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen3-vl:8b

# === Питательность (шаг 2) ===
# Бесплатный ключ: fdc.nal.usda.gov. Нужен при любом провайдере модели.
USDA_API_KEY=

# === Опционально ===
# DB_PATH=data/food.db

# Кука сессии webapp отдаётся с флагом Secure. Поставь 0 только для локальной
# отладки по http — иначе браузер куку не сохранит и вход не сработает.
# На проде (за туннелем с https) не трогать.
# COOKIE_SECURE=1

# ngrok-переменных здесь нет: публичный домен и туннель общие с diary
# и настраиваются в ~/diary_api/.env (см. gpt-router в docker-compose там)
