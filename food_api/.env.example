# === API Security ===
# Секретный ключ для доступа к API
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOOD_API_KEY=

# === Часовой пояс ===
# Определяет границы "дня" для подсчёта калорий (IANA-имя зоны).
# Сервер rpi живёт в +04 -> Etc/GMT-4 (знак в Etc/* инвертирован!)
USER_TIMEZONE=Etc/GMT-4

# === Распознавание (шаг 1) ===
# Провайдер или список через запятую — порядок задаёт фолбэк: anthropic,local
RECOGNIZE_PROVIDER=anthropic
# Модель Anthropic. По умолчанию claude-opus-5.
RECOGNIZE_MODEL=
ANTHROPIC_API_KEY=
# Gemini — бесплатный тариф, но Google учится на данных free tier.
GEMINI_API_KEY=
# Модель Gemini. Пусто -> gemini-3.5-flash.
#
# ВНИМАНИЕ про бесплатный тариф (замерено 2026-10-01): квота — 20 запросов
# В СУТКИ на модель, не в минуту. Для ежедневного учёта еды этого не хватает:
# четыре приёма пищи плюс правки съедают её за день. Варианты:
#   - включить оплату в Google AI Studio (gemini-3.8-flash: $0.75/$3.75 за млн
#     токенов, около $6 в год при четырёх приёмах пищи в день);
#   - перечислить несколько моделей в RECOGNIZE_PROVIDER — квота у каждой своя;
#   - поставить ollama и переключиться на local.
#
# Семейство 2.5 снято для новых ключей (404 «no longer available to new users»),
# поэтому значения из старой документации на свежем ключе не работают.
# GEMINI_MODEL=
# Ollama на M4: полный URL эндпоинта, не базовый адрес.
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
LOCAL_LLM_MODEL=qwen3-vl:8b

# === Питательность (шаг 2) ===
# Числа БЖУ даёт модель (на 100 г) и кэширует по lookup_query. Брендовые
# продукты уточняются в Open Food Facts — ему ключ не нужен.
#
# USDA_API_KEY рабочему пути больше НЕ нужен: с 2026-10-01 поиск по USDA из
# него убран, он сопоставлял «кофе с молоком» с шоколадными конфетами.
# Ключ нужен только для замера в Фазе 3, где USDA служит базовой линией.
# Бесплатный ключ: fdc.nal.usda.gov
# USDA_API_KEY=

# === Опционально ===
# DB_PATH=data/food.db

# Кука сессии webapp отдаётся с флагом Secure. Поставь 0 только для локальной
# отладки по http — иначе браузер куку не сохранит и вход не сработает.
# На проде (за туннелем с https) не трогать.
# COOKIE_SECURE=1

# Счётчик попыток входа считает клиентов по адресу сокета. За туннелем это
# адрес прокси — все складываются в одно ведро, и перебор с чужой машины
# заблокирует вход тебе. Назови заголовок с настоящим адресом, и он будет
# взят оттуда. Cloudflare Tunnel: CF-Connecting-IP. Caddy: X-Forwarded-For.
# Пустым оставлять безопасно; заполнять ТОЛЬКО если перед сервисом реально
# стоит прокси, который этот заголовок перезаписывает — иначе его подставит
# сам клиент и обойдёт счётчик.
# TRUST_CLIENT_IP_HEADER=CF-Connecting-IP

# ngrok-переменных здесь нет: публичный домен и туннель общие с diary
# и настраиваются в ~/diary_api/.env (см. gpt-router в docker-compose там)
