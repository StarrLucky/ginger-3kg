# === API Security ===
# Секретный ключ для доступа к API
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOOD_API_KEY=

# === Часовой пояс ===
# Определяет границы "дня" для подсчёта калорий (IANA-имя зоны).
# Сервер rpi живёт в +04 -> Etc/GMT-4 (знак в Etc/* инвертирован!)
USER_TIMEZONE=Etc/GMT-4

# === Опционально ===
# DB_PATH=data/food.db

# ngrok-переменных здесь нет: публичный домен и туннель общие с diary
# и настраиваются в ~/diary_api/.env (см. gpt-router в docker-compose там)
